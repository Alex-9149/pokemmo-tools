---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="PokeMMO Hub — Farmeo de EVs por Hordas"
  description="Guía de farmeo de EVs por hordas con Dulce Aroma en PokeMMO para Kanto, Johto, Hoenn, Sinnoh y Teselia. Muestra la estación actual y los mejores spots por región y estadística."
  activePage="evs"
>
<style is:global>
  :root {
    --bg: #111827; --panel: #1f2937; --panel2: #243244; --panel-head: #243244;
    --border: #374151; --border-solid: #374151; --text: #f8fafc; --muted: #94a3b8;
  }
  /* box-sizing handled by Tailwind preflight */

  .container { max-width: 1400px; width: 100%; margin: 0 auto; padding: 2.25rem 1.5rem 4rem; }
  @media (min-width: 640px) { .container { padding-left: 2rem; padding-right: 2rem; } }
  .page-header { margin-bottom:1.5rem; }
  .page-header h1 { font-family:'Outfit',sans-serif; font-size:2.1rem; font-weight:800; margin-bottom:0.4rem; display:flex; align-items:center; gap:12px; }
  .page-header p { color:var(--muted); font-size:0.95rem; max-width:900px; line-height:1.6; }
  .season-banner { border-radius:16px; padding:1.25rem 1.6rem; margin-bottom:1.75rem; display:flex; align-items:center; justify-content:space-between; gap:1.25rem; border:1px solid transparent; box-shadow:0 8px 28px rgba(0,0,0,0.3); flex-wrap:wrap; }
  .season-banner.spring { background:linear-gradient(135deg,rgba(16,185,129,0.12),rgba(22,30,49,0.9)); border-color:rgba(16,185,129,0.3); }
  .season-banner.summer { background:linear-gradient(135deg,rgba(245,158,11,0.12),rgba(22,30,49,0.9)); border-color:rgba(245,158,11,0.3); }
  .season-banner.autumn { background:linear-gradient(135deg,rgba(249,115,22,0.12),rgba(22,30,49,0.9)); border-color:rgba(249,115,22,0.3); }
  .season-banner.winter { background:linear-gradient(135deg,rgba(6,182,212,0.12),rgba(22,30,49,0.9)); border-color:rgba(6,182,212,0.3); }
  .season-left { display:flex; align-items:center; gap:1.1rem; }
  .season-icon-large { font-size:2.6rem; background:rgba(255,255,255,0.06); border:1px solid var(--border); padding:12px; border-radius:14px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .season-title { font-family:'Outfit',sans-serif; font-size:1.3rem; font-weight:800; }
  .season-desc { color:var(--muted); font-size:0.88rem; margin-top:4px; line-height:1.5; }
  .season-months-badge { display:inline-flex; align-items:center; gap:6px; margin-top:8px; font-size:0.78rem; font-weight:700; padding:3px 9px; border-radius:20px; background:rgba(255,255,255,0.08); color:var(--muted); }
  .season-selector { display:flex; flex-direction:column; gap:6px; flex-shrink:0; }
  .season-selector-label { font-size:0.75rem; color:var(--muted); font-weight:600; text-transform:uppercase; letter-spacing:0.5px; }
  .season-btns { display:flex; gap:6px; flex-wrap:wrap; }
  .season-btn { display:flex; flex-direction:column; align-items:center; gap:3px; padding:8px 14px; border-radius:10px; border:1px solid var(--border); background:rgba(255,255,255,0.04); cursor:pointer; transition:all 0.2s; color:var(--muted); font-size:0.78rem; font-weight:600; line-height:1.2; }
  .season-btn:hover { background:rgba(255,255,255,0.08); color:#fff; }
  .season-btn .s-icon { font-size:1.25rem; }
  .season-btn .s-name { font-weight:700; font-size:0.8rem; }
  .season-btn .s-months { font-size:0.66rem; color:var(--muted); }
  .season-btn.active .s-months { color:inherit; }
  .season-btn[data-s="spring"].active { background:rgba(16,185,129,0.2); border-color:rgba(16,185,129,0.5); color:#34d399; }
  .season-btn[data-s="summer"].active { background:rgba(245,158,11,0.2); border-color:rgba(245,158,11,0.5); color:#fde047; }
  .season-btn[data-s="autumn"].active { background:rgba(249,115,22,0.2); border-color:rgba(249,115,22,0.5); color:#fb923c; }
  .season-btn[data-s="winter"].active { background:rgba(6,182,212,0.2); border-color:rgba(6,182,212,0.5); color:#67e8f9; }
  .stats-legend { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:1.5rem; align-items:center; }
  .legend-label { color:var(--muted); font-size:0.85rem; font-weight:600; margin-right:4px; }
  .stat-pill { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:20px; font-size:0.8rem; font-weight:700; border:1px solid; }
  .stat-pill.hp   { background:rgba(16,185,129,0.15); color:#34d399; border-color:rgba(16,185,129,0.35); }
  .stat-pill.atk  { background:rgba(239,68,68,0.15);  color:#f87171; border-color:rgba(239,68,68,0.35); }
  .stat-pill.def  { background:rgba(59,130,246,0.15); color:#60a5fa; border-color:rgba(59,130,246,0.35); }
  .stat-pill.spatk{ background:rgba(236,72,153,0.15); color:#f472b6; border-color:rgba(236,72,153,0.35); }
  .stat-pill.spdef{ background:rgba(139,92,246,0.15); color:#a78bfa; border-color:rgba(139,92,246,0.35); }
  .stat-pill.spe  { background:rgba(245,158,11,0.15); color:#fbbf24; border-color:rgba(245,158,11,0.35); }
  .regions-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:1rem; align-items:start; }
  .region-col { background:var(--panel); border:1px solid var(--border-solid); border-radius:16px; overflow:hidden; }
  .region-col-header { background:var(--panel-head); padding:14px 16px; border-bottom:1px solid var(--border-solid); text-align:center; }
  .region-name { font-family:'Outfit',sans-serif; font-size:1.05rem; font-weight:800; display:flex; align-items:center; justify-content:center; gap:8px; }
  .stat-row { border-bottom:1px solid var(--border); }
  .stat-row:last-child { border-bottom:0; }
  .stat-row-head { display:flex; align-items:center; gap:10px; padding:11px 14px; cursor:pointer; user-select:none; transition:background 0.15s; }
  .stat-row-head:hover { background:rgba(255,255,255,0.04); }
  .stat-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .stat-dot.hp    { background:#10b981; box-shadow:0 0 6px rgba(16,185,129,0.5); }
  .stat-dot.atk   { background:#ef4444; box-shadow:0 0 6px rgba(239,68,68,0.5); }
  .stat-dot.def   { background:#3b82f6; box-shadow:0 0 6px rgba(59,130,246,0.5); }
  .stat-dot.spatk { background:#ec4899; box-shadow:0 0 6px rgba(236,72,153,0.5); }
  .stat-dot.spdef { background:#8b5cf6; box-shadow:0 0 6px rgba(139,92,246,0.5); }
  .stat-dot.spe   { background:#f59e0b; box-shadow:0 0 6px rgba(245,158,11,0.5); }
  .stat-row-label { font-size:0.88rem; font-weight:700; flex:1; }
  .stat-row-label.hp    { color:#34d399; } .stat-row-label.atk   { color:#f87171; }
  .stat-row-label.def   { color:#60a5fa; } .stat-row-label.spatk { color:#f472b6; }
  .stat-row-label.spdef { color:#a78bfa; } .stat-row-label.spe   { color:#fbbf24; }
  .stat-row-count { font-size:0.75rem; color:var(--muted); font-weight:600; background:rgba(255,255,255,0.06); padding:2px 7px; border-radius:10px; }
  .stat-chevron { font-size:0.72rem; color:var(--muted); transition:transform 0.25s; flex-shrink:0; }
  .stat-row.open .stat-chevron { transform:rotate(180deg); }
  .horde-detail { display:none; background:rgba(11,15,25,0.55); border-top:1px solid var(--border); }
  .stat-row.open .horde-detail { display:block; }
  .horde-item { padding:12px 14px; border-bottom:1px solid rgba(255,255,255,0.05); display:flex; gap:10px; align-items:flex-start; transition:background 0.12s; }
  .horde-item:last-child { border-bottom:0; }
  .horde-item:hover { background:rgba(255,255,255,0.025); }
  .poke-sprite { width:60px; height:60px; flex-shrink:0; background:rgba(255,255,255,0.04); border:1px solid var(--border); border-radius:10px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .poke-sprite img { width:56px; height:56px; object-fit:contain; image-rendering:pixelated; }
  .sprite-fallback { font-size:1.8rem; line-height:1; display:none; }
  .horde-info { flex:1; min-width:0; }
  .horde-name { font-family:'Outfit',sans-serif; font-size:0.92rem; font-weight:700; margin-bottom:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .horde-location { font-size:0.76rem; color:var(--muted); line-height:1.4; margin-bottom:5px; }
  .horde-tags { display:flex; flex-wrap:wrap; gap:4px; margin-bottom:5px; }
  .horde-ev-badge { font-size:0.72rem; font-weight:700; padding:2px 7px; border-radius:6px; }
  .horde-ev-badge.hp    { background:rgba(16,185,129,0.2); color:#34d399; }
  .horde-ev-badge.atk   { background:rgba(239,68,68,0.2);  color:#f87171; }
  .horde-ev-badge.def   { background:rgba(59,130,246,0.2); color:#60a5fa; }
  .horde-ev-badge.spatk { background:rgba(236,72,153,0.2); color:#f472b6; }
  .horde-ev-badge.spdef { background:rgba(139,92,246,0.2); color:#a78bfa; }
  .horde-ev-badge.spe   { background:rgba(245,158,11,0.2); color:#fbbf24; }
  .horde-method-badge { font-size:0.7rem; font-weight:600; padding:2px 7px; border-radius:6px; background:rgba(255,255,255,0.07); color:#cbd5e1; }
  .season-tag-mini { font-size:0.68rem; font-weight:700; padding:2px 6px; border-radius:5px; }
  .season-tag-mini.all    { background:rgba(255,255,255,0.07); color:#94a3b8; }
  .season-tag-mini.spring { background:rgba(16,185,129,0.2); color:#34d399; }
  .season-tag-mini.summer { background:rgba(245,158,11,0.2); color:#fbbf24; }
  .season-tag-mini.autumn { background:rgba(249,115,22,0.2); color:#fb923c; }
  .season-tag-mini.winter { background:rgba(6,182,212,0.2); color:#38bdf8; }
  .rec-star { font-size:0.68rem; font-weight:700; background:rgba(59,130,246,0.2); color:#60a5fa; padding:2px 6px; border-radius:5px; }
  .horde-note { font-size:0.74rem; color:#94a3b8; line-height:1.45; }
  .empty-spot { font-size:0.8rem; color:var(--muted); font-style:italic; text-align:center; padding:14px; }
  @media (max-width:1280px) { .regions-grid { grid-template-columns:repeat(3,1fr); } }
  @media (max-width:900px)  { .regions-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:600px)  { .regions-grid { grid-template-columns:1fr; } .page-header h1 { font-size:1.5rem; } }
</style>

<div class="container">
  <div class="page-header">
    <h1>Farmeo de EVs &#8212; Hordas con Dulce Aroma</h1>
    <p>
      Spots verificados de farmeo de EVs por hordas en <strong>Kanto, Johto, Hoenn, Sinnoh y Teselia</strong>.
      Haz clic en cualquier estadistica para ver los mejores spots disponibles en esa region durante la estacion actual.
    </p>
  </div>

  <div class="season-banner" id="seasonBanner">
    <div class="season-left">
      <div class="season-icon-large" id="seasonIcon">&#127800;</div>
      <div>
        <div class="season-title" id="seasonTitle">Estacion en PokeMMO: Primavera</div>
        <div class="season-desc" id="seasonDesc">Las estaciones en PokeMMO rotan mensualmente segun el mes real.</div>
        <div class="season-months-badge" id="seasonMonths">&#128197; Enero &middot; Mayo &middot; Septiembre</div>
      </div>
    </div>
    <div class="season-selector">
      <div class="season-selector-label">Simular estacion:</div>
      <div class="season-btns">
        <button class="season-btn" data-s="spring" onclick="setSeason('spring')">
          <span class="s-icon">🌸</span><span class="s-name">Primavera</span><span class="s-months">Ene &middot; May &middot; Sep</span>
        </button>
        <button class="season-btn" data-s="summer" onclick="setSeason('summer')">
          <span class="s-icon">&#9728;&#65039;</span><span class="s-name">Verano</span><span class="s-months">Feb &middot; Jun &middot; Oct</span>
        </button>
        <button class="season-btn" data-s="autumn" onclick="setSeason('autumn')">
          <span class="s-icon">🍂</span><span class="s-name">Otono</span><span class="s-months">Mar &middot; Jul &middot; Nov</span>
        </button>
        <button class="season-btn" data-s="winter" onclick="setSeason('winter')">
          <span class="s-icon">&#10052;&#65039;</span><span class="s-name">Invierno</span><span class="s-months">Abr &middot; Ago &middot; Dic</span>
        </button>
      </div>
    </div>
  </div>

  <div class="stats-legend">
    <span class="legend-label">Stats:</span>
    <span class="stat-pill hp">PS (HP)</span>
    <span class="stat-pill atk">Ataque</span>
    <span class="stat-pill def">Defensa</span>
    <span class="stat-pill spatk">Atq. Esp.</span>
    <span class="stat-pill spdef">Def. Esp.</span>
    <span class="stat-pill spe">Velocidad</span>
  </div>

  <div class="regions-grid" id="regionsGrid"></div>
</div>

<script is:inline>
var seasonData = {
  spring: { title:"Primavera (Spring)", icon:"🌸", desc:"Las rutas florecen y los caminos de montana estan despejados.", months:"📅 Enero · Mayo · Septiembre", css:"spring" },
  summer: { title:"Verano (Summer)",    icon:"☀️", desc:"Dias largos y alta actividad en costas y zonas maritimas.",    months:"📅 Febrero · Junio · Octubre",   css:"summer" },
  autumn: { title:"Otono (Autumn)",     icon:"🍂", desc:"Hojas caidas y vientos en Teselia; hordas estacionales activas.", months:"📅 Marzo · Julio · Noviembre", css:"autumn" },
  winter: { title:"Invierno (Winter)",  icon:"❄️", desc:"Nieve en Teselia; aparecen Beartic/Vanillite en Monte Tuerca.", months:"📅 Abril · Agosto · Diciembre", css:"winter" }
};

function getCurrentSeason() {
  var m = new Date().getMonth();
  if (m===0||m===4||m===8) return "spring";
  if (m===1||m===5||m===9) return "summer";
  if (m===2||m===6||m===10) return "autumn";
  return "winter";
}

var realSeason = getCurrentSeason();
var currentSeason = realSeason;

function setSeason(season) {
  currentSeason = season;
  var sd = seasonData[season];
  document.getElementById("seasonBanner").className = "season-banner " + sd.css;
  document.getElementById("seasonIcon").textContent  = sd.icon;
  var label = season === realSeason ? "Estacion actual en PokeMMO: " : "Viendo estacion: ";
  document.getElementById("seasonTitle").textContent = label + sd.title;
  document.getElementById("seasonDesc").textContent  = sd.desc;
  document.getElementById("seasonMonths").textContent = sd.months;
  document.querySelectorAll(".season-btn").forEach(function(btn) {
    btn.classList.toggle("active", btn.dataset.s === season);
  });
  var grid = document.getElementById("regionsGrid");
  grid.innerHTML = "";
  regions.forEach(function(r) { grid.appendChild(buildColumn(r)); });
}

var evSpots = [
  { region:"kanto", stat:"hp",    pokemon:"Caterpie / Metapod",    pokedexId:10,  evYield:"+5-10 EVs",            location:"Bosque Verde (Viridian Forest)",          method:"Dulce Aroma en hierba alta",        icon:"🐛", season:"all",    rec:false, note:"Horda de 5 Caterpie/Metapod. Facil de limpiar en niveles bajos." },
  { region:"kanto", stat:"atk",   pokemon:"Paras",                  pokedexId:46,  evYield:"+5 EVs (+10 c/Brazal)", location:"Monte Moon (planta baja)",               method:"Dulce Aroma bajo techo (sin lluvia)", icon:"🍄", season:"all",    rec:true,  note:"Al estar bajo techo, el Dulce Aroma nunca se bloquea por lluvia." },
  { region:"kanto", stat:"def",   pokemon:"Geodude",                pokedexId:74,  evYield:"+5 EVs (+10 c/Brazal)", location:"Tunel Roca / Calle Victoria",            method:"Dulce Aroma en cueva interior",     icon:"🪨", season:"all",    rec:true,  note:"Horda de 5 Geodude. Eliminaos con Surf o Chispazo al instante." },
  { region:"kanto", stat:"spatk", pokemon:"Golduck",                pokedexId:55,  evYield:"+10 EVs (+20 c/Brazal)",location:"Cabo Extremo - Isla 2 (Cape Brink)",     method:"Dulce Aroma con Surf",              icon:"🦆", season:"all",    rec:true,  note:"Uno de los mejores spots del juego. +2 EVs por Golduck." },
  { region:"kanto", stat:"spdef", pokemon:"Tentacool",              pokedexId:72,  evYield:"+5 EVs (+10 c/Brazal)", location:"Ruta 21 / Sur de Pueblo Paleta",         method:"Dulce Aroma con Surf en el mar",    icon:"🦑", season:"all",    rec:false, note:"Horda de 5 Tentacool en el mar al sur. Cuidado con la lluvia." },
  { region:"kanto", stat:"spe",   pokemon:"Poliwag",                pokedexId:60,  evYield:"+5 EVs (+10 c/Brazal)", location:"Ruta 22 / Ruta 6 (Agua)",               method:"Dulce Aroma con Surf",              icon:"🌀", season:"all",    rec:true,  note:"Horda de 5 Poliwag garantizados. Limpia con Chispazo o Gigadrenado." },
  { region:"kanto", stat:"spe",   pokemon:"Rattata / Pidgey",       pokedexId:19,  evYield:"+5 EVs (+10 c/Brazal)", location:"Ruta 1",                                method:"Dulce Aroma en hierba",             icon:"🐀", season:"all",    rec:false, note:"Ideal para crias de nivel 1 que aun no aguantan ataques fuertes." },
  { region:"johto", stat:"hp",    pokemon:"Wooper",                 pokedexId:194, evYield:"+5 EVs (+10 c/Brazal)", location:"Cueva Union (Piso acuatico inferior)",   method:"Dulce Aroma con Surf bajo techo",   icon:"🐟", season:"all",    rec:true,  note:"Bajo techo: nunca llueve. Limpieza rapida con Chispazo o Energibola." },
  { region:"johto", stat:"atk",   pokemon:"Ursaring / Primeape",    pokedexId:217, evYield:"+10 EVs (+20 c/Brazal)",location:"Ruta 28 / Monte Plateado",              method:"Dulce Aroma en hierba alta",        icon:"🐻", season:"all",    rec:true,  note:"Endgame. Horda de 5 Ursaring (+2 Atk c/u). Maxima EXP tambien." },
  { region:"johto", stat:"def",   pokemon:"Graveler / Geodude",     pokedexId:75,  evYield:"+10 EVs (+20 c/Brazal)",location:"Monte Mortero (Mt. Mortar)",            method:"Dulce Aroma en cueva interior",     icon:"🗿", season:"all",    rec:true,  note:"Horda de 5 Graveler (+2 Def c/u). Seguro e ininterrumpible." },
  { region:"johto", stat:"spatk", pokemon:"Girafarig",              pokedexId:203, evYield:"+10 EVs (+20 c/Brazal)",location:"Ruta 43 - Lago de la Furia",            method:"Dulce Aroma en hierba",             icon:"🦒", season:"all",    rec:false, note:"5 Girafarig (+2 Atq Esp c/u). Si llueve junto al lago Dulce Aroma falla." },
  { region:"johto", stat:"spdef", pokemon:"Tentacool / Tentacruel", pokedexId:72,  evYield:"+5-10 EVs",             location:"Ruta 41 (Islas Remolino)",              method:"Dulce Aroma con Surf",              icon:"🌊", season:"all",    rec:true,  note:"Horda entre Ciudad Olivo y Orquidea. Limpieza rapida con Chispazo." },
  { region:"johto", stat:"spe",   pokemon:"Golbat",                 pokedexId:42,  evYield:"+10 EVs (+20 c/Brazal)",location:"Guarida Dragon (Dragon's Den)",         method:"Dulce Aroma con Surf en cueva",     icon:"🦇", season:"all",    rec:true,  note:"5 Golbat (+2 Velocidad c/u). Cueva protegida del clima exterior." },
  { region:"johto", stat:"spe",   pokemon:"Poliwhirl",              pokedexId:61,  evYield:"+10 EVs (+20 c/Brazal)",location:"Monte Plateado (Agua)",                 method:"Dulce Aroma con Surf",              icon:"🌀", season:"all",    rec:true,  note:"5 Poliwhirl (+2 Velocidad c/u) surfeando en el agua del Monte Plateado." },
  { region:"hoenn", stat:"hp",    pokemon:"Marill",                 pokedexId:183, evYield:"+10 EVs (+20 c/Brazal)",location:"Ruta 114 (Estanque / Cascada)",         method:"Dulce Aroma con Surf en agua dulce", icon:"🐭", season:"all",   rec:true,  note:"El mejor spot de PS de TODO PokeMMO! 100% Marill (+2 PS c/u)." },
  { region:"hoenn", stat:"atk",   pokemon:"Shuppet",                pokedexId:353, evYield:"+5 EVs (+10 c/Brazal)", location:"Monte Pirico (Mt. Pyre - Interior)",    method:"Dulce Aroma en edificio cerrado",   icon:"👻", season:"all",    rec:true,  note:"Edificio cerrado: nunca llueve. Evita movimientos Normal/Lucha." },
  { region:"hoenn", stat:"def",   pokemon:"Torkoal",                pokedexId:324, evYield:"+10 EVs (+20 c/Brazal)",location:"Senda Ignea (Fiery Path)",              method:"Dulce Aroma en cueva central",      icon:"🐢", season:"all",    rec:true,  note:"5 Torkoal (+2 Def c/u). Limpia con Surf o Terremoto." },
  { region:"hoenn", stat:"spatk", pokemon:"Spinda",                 pokedexId:327, evYield:"+5 EVs (+10 c/Brazal)", location:"Ruta 113 (Ceniza volcanica)",           method:"Dulce Aroma en hierba de ceniza",   icon:"🐼", season:"all",    rec:false, note:"Si tienes acceso a Kanto/Teselia, Golduck en Cabo Extremo es mas rapido." },
