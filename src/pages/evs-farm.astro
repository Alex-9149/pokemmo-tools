  { id:"johto",  name:"Johto",   icon:"" },
  { id:"hoenn",  name:"Hoenn",   icon:"" },
  { id:"sinnoh", name:"Sinnoh",  icon:"" },
  { id:"unova",  name:"Teselia", icon:"" }
];

var stats = [
  { id:"hp",    label:"PS (HP)",       emoji:"" },
  { id:"atk",   label:"Ataque",        emoji:"" },
  { id:"def",   label:"Defensa",       emoji:"" },
  { id:"spatk", label:"Atq. Especial", emoji:"" },
  { id:"spdef", label:"Def. Especial", emoji:"" },
  { id:"spe",   label:"Velocidad",     emoji:"" }
];

var seasonLabels = {
  all:    { text:"Todo el anno",  cls:"all" },
  spring: { text:"🌸 Primavera", cls:"spring" },
  summer: { text:"☀️ Verano",    cls:"summer" },
  autumn: { text:"🍂 Otono",     cls:"autumn" },
  winter: { text:"❄️ Invierno",  cls:"winter" }
};

function spriteUrl(id) {
  return "https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/" + id + ".png";
}

function buildColumn(region) {
  var col = document.createElement("div");
  col.className = "region-col";
  var header = document.createElement("div");
  header.className = "region-col-header";
  header.innerHTML = '<div class="region-name"><span>' + region.icon + '</span>' + region.name + '</div>';
  col.appendChild(header);

  stats.forEach(function(stat) {
    var spots = evSpots.filter(function(s) {
      return s.region === region.id && s.stat === stat.id && (s.season === "all" || s.season === currentSeason);
    });
    var row = document.createElement("div");
    row.className = "stat-row";
    var head = document.createElement("div");
    head.className = "stat-row-head";
    head.innerHTML =
      '<span class="stat-dot ' + stat.id + '"></span>' +
      '<span class="stat-row-label ' + stat.id + '">' + stat.emoji + ' ' + stat.label + '</span>' +
      '<span class="stat-row-count">' + spots.length + '</span>' +
      '<span class="stat-chevron">&#9660;</span>';
    head.addEventListener("click", function() { row.classList.toggle("open"); });
    row.appendChild(head);

    var detail = document.createElement("div");
    detail.className = "horde-detail";

    if (spots.length === 0) {
      var empty = document.createElement("div");
      empty.className = "empty-spot";
      empty.textContent = "Sin spots en esta estacion";
      detail.appendChild(empty);
    } else {
      spots.forEach(function(spot) {
        var item = document.createElement("div");
        item.className = "horde-item";
        var sLabel = seasonLabels[spot.season];
        var recHtml = spot.rec ? '<span class="rec-star">⭐ Top</span>' : "";
        var img = document.createElement("img");
        img.src = spriteUrl(spot.pokedexId);
        img.alt = spot.pokemon;
        img.style.cssText = "width:56px;height:56px;object-fit:contain;image-rendering:pixelated;";
        var fallback = document.createElement("span");
        fallback.className = "sprite-fallback";
        fallback.textContent = spot.icon;
        img.onerror = function() { img.style.display = "none"; fallback.style.display = "flex"; };
        var spriteDiv = document.createElement("div");
        spriteDiv.className = "poke-sprite";
        spriteDiv.appendChild(img);
        spriteDiv.appendChild(fallback);
        var infoDiv = document.createElement("div");
        infoDiv.className = "horde-info";
        infoDiv.innerHTML =
          '<div class="horde-name" title="' + spot.pokemon + '">' + spot.pokemon + '</div>' +
          '<div class="horde-location">📍 ' + spot.location + '</div>' +
          '<div class="horde-tags">' +
            '<span class="horde-ev-badge ' + spot.stat + '">' + spot.evYield + '</span>' +
            '<span class="horde-method-badge">' + spot.method + '</span>' +
            '<span class="season-tag-mini ' + sLabel.cls + '">' + sLabel.text + '</span>' +
            recHtml +
          '</div>' +
          '<div class="horde-note">' + spot.note + '</div>';
        item.appendChild(spriteDiv);
        item.appendChild(infoDiv);
        detail.appendChild(item);
      });
    }
    row.appendChild(detail);
    col.appendChild(row);
  });
  return col;
}

setSeason(realSeason);
