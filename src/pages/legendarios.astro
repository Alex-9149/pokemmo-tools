  function getSprite(id) {
    return 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/' + id + '.png';
  }

  // Render the two active roaming legendaries at the top
  function renderActiveRotation(monthIndex) {
    var rotation = monthlyRotations[monthIndex];
    var bird = roamingDetails[rotation.bird];
    var beast = roamingDetails[rotation.beast];

    var container = document.getElementById('activeRotationGrid');
    container.innerHTML = '';

    var activeList = [
      { data: bird, regionCls: 'kanto', regionName: 'Kanto', role: 'Ave Legendaria Salvaje' },
      { data: beast, regionCls: 'johto', regionName: 'Johto', role: 'Bestia Legendaria Salvaje' }
    ];

    activeList.forEach(function(item) {
      var p = item.data;
      var card = document.createElement('div');
      card.className = 'spotlight-card ' + item.regionCls;

      var typeBadgesHtml = p.types.map(function(t) {
        return '<span class="type-badge ' + t.cls + '">' + t.name + '</span>';
      }).join('');

      card.innerHTML =
        '<div class="card-top-header">' +
          '<span class="region-tag ' + item.regionCls + '">' +
            item.regionName + ' · ' + item.role +
          '</span>' +
          '<span class="status-badge-active">' +
            '<span class="status-dot-pulse"></span>' +
            'ACTIVO ESTE MES' +
          '</span>' +
        '</div>' +
        '<div class="card-main-content">' +
          '<div class="sprite-container">' +
            '<img src="' + getSprite(p.id) + '" alt="' + p.name + '" loading="lazy" />' +
          '</div>' +
          '<div class="poke-title-area">' +
            '<div class="poke-name">' + p.name + '</div>' +
            '<div class="type-badges">' + typeBadgesHtml + '</div>' +
            '<div class="group-info">' + p.category + ' &bull; #' + p.id + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="info-details-box">' +
          '<div class="detail-row">' +
            '<div>' +
              '<span class="detail-label">Requisito de desbloqueo:</span><br>' +
              '<span class="detail-sub">' + p.unlock + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="detail-row">' +
            '<div>' +
              '<span class="detail-label">Dónde encontrarlo:</span><br>' +
              '<span class="detail-sub">' + p.location + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="detail-row">' +
            '<div>' +
              '<span class="detail-label">Mecánica de aparición:</span><br>' +
              '<span class="detail-sub">' + p.rate + ' ' + p.tips + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="detail-row">' +
            '<div>' +
              '<span class="detail-label">Meses en rotación:</span><br>' +
              '<span class="detail-sub">' + p.months + '</span>' +
            '</div>' +
          '</div>' +
        '</div>';

      container.appendChild(card);
    });

    // Update banner texts
    var realMonth = new Date().getMonth();
    var isCurrent = (parseInt(monthIndex, 10) === realMonth);
    document.getElementById('monthTitle').textContent =
      (isCurrent ? 'Rotación Activa en PokeMMO (' : 'Previsualizando Rotación de ') + rotation.monthName + ')';
    document.getElementById('monthSubtitle').textContent =
      'Pájaro de Kanto: ' + rotation.bird + ' | Bestia de Johto: ' + rotation.beast + ' (Cambia el 1 de cada mes 00:00 UTC).';
  }

  // Render the bottom list of all legendary Pokémon
  var currentCat = 'all';
  var currentQuery = '';

  function renderAllLegends() {
    var container = document.getElementById('allLegendsGrid');
    container.innerHTML = '';

    var filtered = allLegendaries.filter(function(leg) {
      var matchesCat = (currentCat === 'all' || leg.category === currentCat);
      var q = currentQuery.toLowerCase().trim();
      var matchesQuery = !q ||
        leg.name.toLowerCase().includes(q) ||
        leg.region.toLowerCase().includes(q) ||
        leg.where.toLowerCase().includes(q) ||
        leg.method.toLowerCase().includes(q);
      return matchesCat && matchesQuery;
    });

    if (filtered.length === 0) {
      container.innerHTML =
        '<div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: #94a3b8; background: rgba(22,30,49,0.5); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1);">' +
          '<div style="font-weight: 700; font-size: 1.1rem; color: #f8fafc; margin-bottom: 4px;">No se encontraron resultados</div>' +
          '<div style="font-size: 0.85rem;">Prueba con otro término de búsqueda o selecciona otra categoría.</div>' +
        '</div>';
      return;
    }

    filtered.forEach(function(p) {
      var card = document.createElement('div');
      card.className = 'legend-item-card';

      var typesHtml = p.types.map(function(t) {
        return '<span class="type-badge ' + t.cls + '">' + t.name + '</span>';
      }).join('');

      card.innerHTML =
        '<div class="item-top">' +
          '<div class="item-sprite">' +
            '<img src="' + getSprite(p.id) + '" alt="' + p.name + '" loading="lazy" />' +
          '</div>' +
          '<div class="item-meta">' +
            '<div class="item-name">' +
              '<span>' + p.name + '</span>' +
              '<span class="category-pill ' + p.catClass + '">' + p.categoryLabel + '</span>' +
            '</div>' +
            '<div style="display: flex; gap: 6px; align-items: center; margin-top: 3px;">' +
              typesHtml +
              '<span style="font-size: 0.75rem; color: #94a3b8; margin-left: auto;">' + p.region + '</span>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="item-body">' +
          '<div class="info-snippet">' +
            '<strong>Método:</strong> <span>' + p.method + '</span>' +
          '</div>' +
          '<div class="info-snippet">' +
            '<strong>Ubicación:</strong> <span>' + p.where + '</span>' +
          '</div>' +
          '<div class="info-snippet">' +
            '<strong>Detalles:</strong> <span>' + p.how + '</span>' +
          '</div>' +
          '<div style="margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center;">' +
            '<span class="' + p.ownershipClass + '">' +
              p.ownership +
            '</span>' +
            '<span style="font-size: 0.72rem; color: #64748b; font-weight: 600;">#' + p.id + '</span>' +
          '</div>' +
        '</div>';

      container.appendChild(card);
    });
  }

  // Update counters in buttons
  function updateCounters() {
    var countAll = allLegendaries.length;
    var el = document.getElementById('count-all');
    if (el) el.textContent = countAll;
  }

  // Setup interactions
  document.addEventListener('DOMContentLoaded', function() {
    var realMonth = new Date().getMonth();
    var select = document.getElementById('monthSelect');
    if (select) {
      select.value = realMonth;
      select.addEventListener('change', function(e) {
        renderActiveRotation(parseInt(e.target.value, 10));
      });
    }

    renderActiveRotation(realMonth);
    updateCounters();
    renderAllLegends();

    // Search event
    var search = document.getElementById('searchInput');
    if (search) {
      search.addEventListener('input', function(e) {
        currentQuery = e.target.value;
        renderAllLegends();
      });
    }

    // Filter pills
    var filterBtns = document.querySelectorAll('#categoryFilters .filter-btn');
    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentCat = btn.dataset.cat;
        renderAllLegends();
      });
    });
  });
</script>
</Layout>
