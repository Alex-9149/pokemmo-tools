---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="PokeMMO — Legendarios en Rotación y Guía"
  description="Consulta los Pokémon Legendarios activos este mes en PokeMMO (Aves de Kanto y Bestias de Johto) y la guía completa de cómo y dónde encontrar a todos los legendarios."
  activePage="legendarios"
>
<style is:global>
  :root {
    --bg: #0b0f19;
    --panel: rgba(22, 30, 49, 0.75);
    --panel-solid: #161e31;
    --panel-head: #243244;
    --panel-dark: #131b2e;
    --border: rgba(255, 255, 255, 0.08);
    --border-solid: #2d3b55;
    --text: #f8fafc;
    --muted: #94a3b8;
    --accent: #3b82f6;
    --gold: #f59e0b;
    --ready: #22c55e;
    --danger: #ef4444;
    --purple: #8b5cf6;
    --cyan: #06b6d4;
  }

  .container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 4rem;
  }
  @media (min-width: 640px) {
    .container {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .page-header p {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 950px;
    line-height: 1.6;
  }

  /* Month Bar */
  .month-bar {
    background: linear-gradient(135deg, rgba(37,99,235,0.12), rgba(139,92,246,0.12));
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 18px;
    padding: 1.25rem 1.75rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  .month-info-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .month-icon-badge {
    width: 52px;
    height: 52px;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #93c5fd;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
    flex-shrink: 0;
  }
  .month-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
  }
  .month-subtitle {
    color: var(--muted);
    font-size: 0.88rem;
    margin-top: 4px;
  }
  .month-selector {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .month-select {
    background: var(--panel-head);
    color: #f8fafc;
    border: 1px solid var(--border-solid);
    padding: 8px 14px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    outline: none;
    transition: all 0.2s;
  }
  .month-select:hover, .month-select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.3);
  }

  /* Section Title */
  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.25rem;
    margin-top: 1.5rem;
  }
  .section-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-title svg {
    color: #60a5fa;
  }
  .section-line {
    height: 1px;
    flex: 1;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Active Spotlight Cards Grid */
  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .spotlight-card {
    background: var(--panel);
    border: 1px solid var(--border-solid);
    border-radius: 20px;
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(14px);
    transition: transform 0.25s, box-shadow 0.25s;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
  }
  .spotlight-card:hover {
    transform: translateY(-3px);
  }
  .spotlight-card.kanto {
    border-color: rgba(245, 158, 11, 0.35);
    background: radial-gradient(circle at 100% 0%, rgba(245, 158, 11, 0.08), rgba(22, 30, 49, 0.85) 60%);
  }
  .spotlight-card.kanto:hover {
    box-shadow: 0 14px 40px rgba(245, 158, 11, 0.18);
  }
  .spotlight-card.johto {
    border-color: rgba(6, 182, 212, 0.35);
    background: radial-gradient(circle at 100% 0%, rgba(6, 182, 212, 0.08), rgba(22, 30, 49, 0.85) 60%);
  }
  .spotlight-card.johto:hover {
    box-shadow: 0 14px 40px rgba(6, 182, 212, 0.18);
  }

  .card-top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .region-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 4px 10px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .region-tag.kanto {
    background: rgba(239, 68, 68, 0.18);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  .region-tag.johto {
    background: rgba(245, 158, 11, 0.18);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .status-badge-active {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 8px;
    background: rgba(34, 197, 94, 0.16);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.35);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .status-dot-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse 2s infinite;
  }

  .card-main-content {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .sprite-container {
    width: 105px;
    height: 105px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.4);
  }
  .sprite-container img {
    width: 90px;
    height: 90px;
    object-fit: contain;
    image-rendering: pixelated;
    transition: transform 0.3s;
  }
  .spotlight-card:hover .sprite-container img {
    transform: scale(1.1);
  }

  .poke-title-area {
    flex: 1;
    min-width: 0;
  }
  .poke-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.7rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 6px;
  }
  .type-badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .type-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2.5px 8px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .group-info {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .info-details-box {
    background: rgba(11, 15, 25, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .detail-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .detail-label {
    color: #e2e8f0;
    font-weight: 600;
    font-size: 0.84rem;
  }
  .detail-sub {
    color: var(--muted);
    font-size: 0.82rem;
  }

  /* Filter / Search Bar */
  .controls-bar {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .search-box-wrap {
    flex: 1;
    min-width: 240px;
    position: relative;
  }
  .search-input {
    width: 100%;
    background: rgba(11, 15, 25, 0.75);
    border: 1px solid var(--border-solid);
    color: #f8fafc;
    padding: 9px 14px 9px 38px;
    border-radius: 10px;
    font-size: 0.88rem;
    outline: none;
    transition: all 0.2s;
  }
  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.25);
  }
  .search-icon-svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .filter-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 7px 13px;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  .filter-btn.active {
    background: rgba(59, 130, 246, 0.22);
    border-color: rgba(59, 130, 246, 0.5);
    color: #93c5fd;
  }

  /* Legendary List Cards */
  .legends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 1.25rem;
  }
  .legend-item-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .legend-item-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .item-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .item-sprite {
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .item-sprite img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .item-meta {
    flex: 1;
    min-width: 0;
  }
  .item-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 3px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .category-pill {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .cat-roaming { background: rgba(59, 130, 246, 0.18); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
  .cat-raid { background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .cat-koth { background: rgba(239, 68, 68, 0.18); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  .cat-event { background: rgba(168, 85, 247, 0.18); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
  .cat-story { background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
  .cat-boss { background: rgba(148, 163, 184, 0.18); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3); }

  .item-body {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .info-snippet {
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .info-snippet strong {
    color: #e2e8f0;
  }
  .info-snippet span {
    color: var(--muted);
  }

  .status-tag-permanent {
    font-size: 0.7rem;
    font-weight: 700;
    color: #34d399;
    display: inline-flex;
    align-items: center;
  }
  .status-tag-temporary {
    font-size: 0.7rem;
    font-weight: 700;
    color: #f87171;
    display: inline-flex;
    align-items: center;
  }
  .status-tag-event {
    font-size: 0.7rem;
    font-weight: 700;
    color: #c084fc;
    display: inline-flex;
    align-items: center;
  }

  /* Type Pill Styles */
  .type-fire     { background: #ef4444; color: #fff; }
  .type-water    { background: #3b82f6; color: #fff; }
  .type-electric { background: #eab308; color: #1e1b4b; font-weight: 800; }
  .type-ice      { background: #06b6d4; color: #082f49; font-weight: 800; }
  .type-flying   { background: #818cf8; color: #fff; }
  .type-psychic  { background: #ec4899; color: #fff; }
  .type-steel    { background: #94a3b8; color: #0f172a; font-weight: 800; }
  .type-dragon   { background: #7c3aed; color: #fff; }
  .type-fighting { background: #b91c1c; color: #fff; }
  .type-normal   { background: #78716c; color: #fff; }
  .type-ghost    { background: #6b21a8; color: #fff; }
  .type-grass    { background: #22c55e; color: #052e16; font-weight: 800; }
  .type-dark     { background: #475569; color: #fff; }
  .type-ground   { background: #d97706; color: #fff; }
  .type-rock     { background: #78350f; color: #fff; }

  /* Info callout banner */
  .callout-box {
    margin-top: 2rem;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    background: rgba(30, 41, 59, 0.45);
    border: 1px solid var(--border);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .callout-icon-svg {
    color: #60a5fa;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .callout-text h4 {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
  }
  .callout-text p {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>

<div class="container">

  <!-- Header -->
  <header class="page-header">
    <h1>
      <span>Pokémon Legendarios en PokeMMO</span>
    </h1>
    <p>
      Guía de rotación mensual de Pokémon legendarios salvajes (Aves de Kanto y Bestias de Johto) y listado general de todos los legendarios con sus ubicaciones, requisitos y métodos de obtención (Roaming, Incursiones/Raid Dungeons, King of the Hill y Eventos).
    </p>
  </header>

  <!-- Month Rotation Selector Banner -->
  <div class="month-bar" id="monthBanner">
    <div class="month-info-left">
      <div class="month-icon-badge" id="monthBadge">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div>
        <div class="month-title" id="monthTitle">Rotación del Mes Actual</div>
        <div class="month-subtitle" id="monthSubtitle">
          La rotación de legendarios salvajes cambia el día 1 de cada mes a las 00:00 UTC.
        </div>
      </div>
    </div>
    <div class="month-selector">
      <label for="monthSelect" class="text-xs text-slate-400 font-bold uppercase tracking-wider">Ver mes:</label>
      <select id="monthSelect" class="month-select">
        <option value="0">Enero</option>
        <option value="1">Febrero</option>
        <option value="2">Marzo</option>
        <option value="3">Abril</option>
        <option value="4">Mayo</option>
        <option value="5">Junio</option>
        <option value="6">Julio</option>
        <option value="7">Agosto</option>
        <option value="8">Septiembre</option>
        <option value="9">Octubre</option>
        <option value="10">Noviembre</option>
        <option value="11">Diciembre</option>
      </select>
    </div>
  </div>

  <!-- SECTION 1: Activos del Mes (Perro y Pájaro) -->
  <div class="section-title-wrap">
    <div class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span>Legendarios Activos en Rotación Salvaje (Roaming)</span>
    </div>
    <div class="section-line"></div>
  </div>

  <div class="spotlight-grid" id="activeRotationGrid">
    <!-- Populated via JavaScript dynamically based on selected month -->
  </div>

  <!-- SECTION 2: Listado Completo de Legendarios -->
  <div class="section-title-wrap">
    <div class="section-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      <span>Todos los Pokémon Legendarios y Dónde Encontrarlos</span>
    </div>
    <div class="section-line"></div>
  </div>

  <!-- Filter & Search Controls -->
  <div class="controls-bar">
    <div class="search-box-wrap">
      <svg class="search-icon-svg" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Buscar legendario por nombre, región o lugar..." />
    </div>

    <div class="filter-pills" id="categoryFilters">
      <button class="filter-btn active" data-cat="all">Todos (<span id="count-all">0</span>)</button>
      <button class="filter-btn" data-cat="roaming">Roaming salvaje</button>
      <button class="filter-btn" data-cat="raid">Raid permanente</button>
      <button class="filter-btn" data-cat="koth">King of the Hill (PvP)</button>
      <button class="filter-btn" data-cat="event">Evento</button>
      <button class="filter-btn" data-cat="story">Historia / Boss</button>
    </div>
  </div>

  <!-- Grid of All Legendaries -->
  <div class="legends-grid" id="allLegendsGrid">
    <!-- Populated via JavaScript -->
  </div>

  <!-- Informative Callout Note -->
  <div class="callout-box">
    <svg class="callout-icon-svg" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
    <div class="callout-text">
      <h4>Mecánica de Legendarios en PokeMMO</h4>
      <p>
        A diferencia de los juegos clásicos de consola, PokeMMO ajusta la disponibilidad de los legendarios para mantener el balance y la economía multijugador:
        las <strong>Aves de Kanto</strong> y las <strong>Bestias de Johto</strong> son capturas permanentes con rotación mensual (~1/8.000 de probabilidad en hierba exterior). 
        Los <strong>King of the Hill</strong> (Mewtwo, Rayquaza, Keldeo, Arceus) pertenecen a un solo jugador por canal y requieren duelos PvP forzosos.
        <strong>Heatran</strong> y <strong>Cresselia</strong> se capturan de forma permanente mediante Incursiones cooperativas de 4 jugadores (cooldown de 90 días por captura).
      </p>
    </div>
  </div>

</div>

<script is:inline>
  // Rotation data by month (0 = Enero, 1 = Febrero, ..., 11 = Diciembre)
  var monthlyRotations = {
    0:  { monthName: 'Enero',      bird: 'Zapdos',   beast: 'Entei'   },
    1:  { monthName: 'Febrero',    bird: 'Moltres',  beast: 'Suicune' },
    2:  { monthName: 'Marzo',      bird: 'Articuno', beast: 'Raikou'  },
    3:  { monthName: 'Abril',      bird: 'Zapdos',   beast: 'Entei'   },
