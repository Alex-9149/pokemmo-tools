---
// Layout.astro — base layout for all pages
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const {
  title,
  description = 'Centro de herramientas y utilidades para jugadores de PokeMMO',
  activePage = '',
} = Astro.props;
  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <script is:inline>
    // Personalización de colores: cada usuario elige los suyos (localStorage). Sin selección => web original.
    window.THEME_KEYS = [
      { id: 'bg',        label: 'Fondo de la web',          desc: 'El color de fondo general',              def: '#0b0f19' },
      { id: 'panel',     label: 'Tarjetas y paneles',        desc: 'Cajas, tarjetas y contenedores',         def: '#1f2937' },
      { id: 'panel2',    label: 'Cabeceras y paneles 2º',    desc: 'Cabeceras de tarjetas y zonas elevadas', def: '#243244' },
      { id: 'primary',   label: 'Color primario',            desc: 'Acentos, enlaces y elementos activos',   def: '#3b82f6' },
      { id: 'secondary', label: 'Color secundario',          desc: 'Brillos y detalles complementarios',     def: '#8b5cf6' },
      { id: 'button',    label: 'Botones',                   desc: 'Botones y pestañas activas',             def: '#3b82f6' },
      { id: 'gold',      label: 'Destacado / dorado',        desc: 'Insignias, avisos y estrellas',          def: '#f59e0b' },
      { id: 'text',      label: 'Texto principal',           desc: 'Títulos y texto importante',             def: '#f8fafc' },
      { id: 'muted',     label: 'Texto secundario',          desc: 'Descripciones y textos apagados',        def: '#94a3b8' },
      { id: 'border',    label: 'Bordes',                    desc: 'Líneas y separadores',                   def: '#ffffff' },
    ];
    window.applyThemeColors = function (custom) {
      const s = document.documentElement.style;
      const set = (names, v) => names.forEach((n) => (v == null ? s.removeProperty(n) : s.setProperty(n, v)));
      const mix = (c, w, pct) => 'color-mix(in srgb, ' + c + ', ' + w + ' ' + pct + '%)';
      const g = (k) => (custom && custom[k]) || null;
      set(['--bg', '--color-bg-deep'], g('bg'));
      set(['--panel', '--color-panel-dark', '--color-panel'], g('panel'));
      set(['--panel2', '--panel-head', '--color-panel-2'], g('panel2'));
      const p = g('primary');
      set(['--accent', '--color-accent-blue', '--color-blue-500'], p);
      set(['--color-blue-600'], p && mix(p, '#000', 15));
      set(['--color-blue-400'], p && mix(p, '#fff', 18));
      set(['--color-blue-300'], p && mix(p, '#fff', 40));
      set(['--glow-1'], p && mix(p, 'transparent', 85));
      const sc = g('secondary');
      set(['--color-accent-purple', '--color-purple-500', '--color-violet-500'], sc);
      set(['--glow-2'], sc && mix(sc, 'transparent', 88));
      const gd = g('gold');
      set(['--color-accent-gold', '--color-accent-amber', '--color-amber-500', '--color-amber-400'], gd);
      const t = g('text');
      set(['--text', '--color-text'], t);
      set(['--muted', '--color-muted', '--color-slate-400', '--color-slate-500'], g('muted'));
      const b = g('border');
      set(['--border', '--color-border'], b && mix(b, 'transparent', 86));
      set(['--border-solid', '--border-2', '--color-border-2'], b && mix(b, 'transparent', 70));
      const bt = g('button');
      set(['--btn'], bt);
      document.documentElement.classList.toggle('cc-btn', !!bt);
    };
    try {
      const c = JSON.parse(localStorage.getItem('theme-custom') || 'null');
      if (c && typeof c === 'object') window.applyThemeColors(c);
    } catch (e) {}
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://unpkg.com/lenis@1.1.18/dist/lenis.css" />
</head>
<body>
  <Navbar activePage={activePage} />
  <slot />
  <Footer />

  <script is:inline src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
  <script is:inline>
    const lenis = new Lenis({
      duration: 2.0,
      wheelMultiplier: 1.2,
      smoothWheel: true,
    });

    window.lenis = lenis;

    // Recalcular el límite de scroll cuando cambia la altura del contenido (desplegables, etc.)
    const refreshLenis = () => lenis.resize();
    new ResizeObserver(refreshLenis).observe(document.body);
    document.addEventListener('toggle', refreshLenis, true);
    document.addEventListener('click', () => {
      setTimeout(refreshLenis, 50);
      setTimeout(refreshLenis, 400);
    }, true);
    new MutationObserver(refreshLenis).observe(document.body, {
      subtree: true, childList: true, attributes: true,
    });

    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
  </script>
</body>
</html>

<style is:global>
  .font-outfit { font-family: 'Outfit', sans-serif; }
</style>
