---
// ThemeToggle.astro — Botón de acuarela + Modal completo para personalizar los colores de la web
// Guarda la configuración exclusivamente en el localStorage del usuario ('theme-custom')
---

<button id="theme-toggle" type="button" class="theme-toggle" aria-label="Personalizar colores" title="Personalizar colores">
  <span class="theme-toggle-glow"></span>
  <svg class="theme-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="13.5" cy="6.5" r="1.2"/><circle cx="17.5" cy="10.5" r="1.2"/><circle cx="8.5" cy="7.5" r="1.2"/><circle cx="6.5" cy="12.5" r="1.2"/>
    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.5-.75 1.5-1.5 0-.39-.15-.74-.39-1.04-.23-.29-.38-.63-.38-1.02 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9z"/>
  </svg>
</button>

<!-- MODAL DE PERSONALIZACIÓN DE COLORES -->
<dialog id="theme-modal" class="theme-modal" aria-labelledby="tm-title">
  <div class="tm-head">
    <div>
      <h2 id="tm-title" class="tm-title">🎨 Personaliza tus colores</h2>
      <p class="tm-sub">Elige los colores a tu gusto. Se guardan en tu navegador sin alterar a otros usuarios.</p>
    </div>
    <button type="button" id="tm-close" class="tm-x" aria-label="Cerrar modal">✕</button>
  </div>

  <div id="tm-list" class="tm-list" data-lenis-prevent></div>

  <div class="tm-foot">
    <button type="button" id="tm-reset-all" class="tm-btn tm-btn-ghost">↺ Restaurar original</button>
    <button type="button" id="tm-done" class="tm-btn tm-btn-main">Guardar y Cerrar</button>
  </div>
</dialog>

<style is:global>
  /* ── Botón Toggle en Navbar ── */
  .theme-toggle {
    position: relative;
    width: 40px !important;
    height: 40px !important;
    min-width: 40px !important;
    padding: 0 !important;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    background: rgba(255, 255, 255, 0.05) !important;
    color: #93c5fd !important;
    cursor: pointer;
    overflow: hidden;
    box-sizing: border-box;
    line-height: 1;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease, box-shadow 0.4s ease;
  }
  .theme-toggle:hover {
    transform: scale(1.1) rotate(-10deg);
    background: rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 0 18px rgba(96, 165, 250, 0.4);
  }
  .theme-toggle:active {
    transform: scale(0.88);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }
  .theme-toggle-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.35), transparent 70%);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.4s ease, transform 0.5s ease;
  }
  .theme-toggle:hover .theme-toggle-glow {
    opacity: 1;
    transform: scale(1);
  }
  .theme-toggle .theme-icon {
    width: 20px !important;
    height: 20px !important;
    flex: none;
    display: block;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .theme-toggle:hover .theme-icon {
    transform: rotate(25deg);
  }

  /* ── Modal Flotante ── */
  .theme-modal {
    margin: auto;
    padding: 0;
    width: min(560px, calc(100vw - 2rem));
    max-height: min(86vh, 760px);
    border-radius: 22px;
    color: #e2e8f0;
    background: linear-gradient(160deg, rgba(30, 41, 59, 0.98), rgba(15, 23, 42, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    flex-direction: column;
  }
  .theme-modal[open] {
    display: flex;
    animation: tm-in 0.35s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .theme-modal.closing {
    animation: tm-out 0.22s ease forwards;
  }
  .theme-modal::backdrop {
    background: rgba(2, 6, 23, 0.65);
    backdrop-filter: blur(6px);
    animation: tm-fade 0.3s ease;
  }
  .theme-modal.closing::backdrop {
    animation: tm-fade 0.22s ease reverse forwards;
  }
  @keyframes tm-in {
    from { opacity: 0; transform: translateY(16px) scale(0.94); }
    to { opacity: 1; transform: none; }
  }
  @keyframes tm-out {
    to { opacity: 0; transform: translateY(10px) scale(0.96); }
  }
  @keyframes tm-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .tm-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 22px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .tm-title {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    color: #f8fafc;
    margin: 0;
  }
  .tm-sub {
    font-size: 0.78rem;
    color: #94a3b8;
    margin: 4px 0 0;
  }
  .tm-x {
    width: 32px !important;
    height: 32px !important;
    padding: 0 !important;
    min-width: 32px !important;
    border-radius: 10px !important;
    border: 0 !important;
    cursor: pointer;
    color: #94a3b8;
    background: transparent !important;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color .2s, color .2s, transform .2s;
  }
  .tm-x:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    color: #fff;
    transform: rotate(90deg);
  }

  .tm-list {
    overflow-y: auto;
    padding: 10px 14px;
    flex: 1;
    min-height: 0;
  }
  .tm-row-wrap {
    border-radius: 14px;
    margin-bottom: 4px;
    transition: background-color .2s;
  }
  .tm-row-wrap:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .tm-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 10px;
  }
  .tm-info {
    flex: 1;
    min-width: 0;
  }
  .tm-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: #f1f5f9;
  }
  .tm-desc {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 1px;
  }
  .tm-mod {
    font-size: 0.6rem;
    font-weight: 700;
    color: #fbbf24;
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-left: 6px;
    opacity: 0;
    transition: opacity .25s;
  }
  .tm-row-wrap.changed .tm-mod {
    opacity: 1;
  }
  .tm-color {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 5px 10px 5px 5px !important;
    border-radius: 12px !important;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem !important;
    color: #cbd5e1 !important;
    transition: transform .2s cubic-bezier(0.34, 1.56, 0.64, 1), border-color .2s, background-color .2s;
  }
  .tm-color:hover {
    transform: scale(1.05);
    border-color: rgba(255, 255, 255, 0.35) !important;
  }
  .tm-color[aria-expanded="true"] {
    border-color: #60a5fa !important;
    background: rgba(96, 165, 250, 0.12) !important;
  }
  .tm-chip {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
    transition: background-color .3s;
    flex-shrink: 0;
  }

  /* Paleta desplegable tipo acordeón */
  .tm-pal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .tm-pal.open {
    grid-template-rows: 1fr;
  }
  .tm-pal-inner {
    overflow: hidden;
    min-height: 0;
  }
  .tm-pal-body {
    padding: 4px 10px 14px;
  }
  .tm-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 6px;
  }
  .tm-sw {
    aspect-ratio: 1;
    padding: 0 !important;
    min-width: unset !important;
    border-radius: 8px !important;
    border: 2px solid transparent !important;
    cursor: pointer;
    transition: transform .15s cubic-bezier(0.34, 1.56, 0.64, 1), border-color .15s;
  }
  .tm-sw:hover {
    transform: scale(1.22);
    z-index: 1;
  }
  .tm-sw.sel {
    border-color: #fff !important;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.25);
  }
  .tm-custom {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }
  .tm-custom input[type="color"] {
    width: 44px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    cursor: pointer;
  }
  .tm-hex {
    flex: 1;
    min-width: 0;
    padding: 7px 10px;
    border-radius: 10px;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #f1f5f9;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.14);
    outline: none;
  }
  .tm-hex:focus {
    border-color: #60a5fa;
  }
  .tm-hex.bad {
    border-color: #ef4444;
  }
  .tm-row-reset {
    padding: 7px 12px !important;
    border-radius: 10px !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: #cbd5e1 !important;
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    cursor: pointer;
    transition: background-color .2s;
  }
  .tm-row-reset:hover {
    background: rgba(255, 255, 255, 0.14) !important;
    color: #fff !important;
  }

  .tm-foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.2);
  }
  .tm-btn {
    padding: 10px 18px !important;
    border-radius: 12px !important;
    font-weight: 700 !important;
    font-size: 0.85rem !important;
    cursor: pointer;
    border: 1px solid transparent !important;
    transition: transform .15s, background-color .2s, box-shadow .25s;
  }
  .tm-btn:active {
    transform: scale(0.96);
  }
  .tm-btn-ghost {
    color: #cbd5e1 !important;
    background: rgba(255, 255, 255, 0.06) !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
  }
  .tm-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.14) !important;
    color: #fff !important;
  }
  .tm-btn-main {
    color: #fff !important;
    background: linear-gradient(135deg, #3b82f6, #6366f1) !important;
    box-shadow: 0 6px 18px rgba(59, 130, 246, 0.35);
  }
  .tm-btn-main:hover {
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.55);
    transform: translateY(-1px);
  }
</style>

<script is:inline>
  (function () {
    const KEYS = window.THEME_KEYS || [];
    const PALETTE = [
      '#ffffff','#f8fafc','#cbd5e1','#94a3b8','#64748b','#475569','#334155','#1f2937','#111827','#000000',
      '#fecaca','#f87171','#ef4444','#dc2626','#991b1b','#fed7aa','#fb923c','#f97316','#ea580c','#9a3412',
      '#fde68a','#fbbf24','#f59e0b','#d97706','#92400e','#bbf7d0','#4ade80','#22c55e','#16a34a','#166534',
      '#a7f3d0','#34d399','#10b981','#059669','#065f46','#a5f3fc','#22d3ee','#06b6d4','#0891b2','#155e75',
      '#bfdbfe','#60a5fa','#3b82f6','#2563eb','#1e40af','#c7d2fe','#818cf8','#6366f1','#4f46e5','#3730a3',
      '#e9d5ff','#c084fc','#8b5cf6','#7c3aed','#5b21b6','#fbcfe8','#f472b6','#ec4899','#db2777','#9d174d',
    ];
    const modal = document.getElementById('theme-modal');
    const list = document.getElementById('tm-list');
    const openBtn = document.getElementById('theme-toggle');
    if (!modal || !list || !openBtn || !window.applyThemeColors) return;

    let custom = {};
    try {
      custom = JSON.parse(localStorage.getItem('theme-custom') || '{}') || {};
    } catch (e) {}
    const rows = {};
    let animT;

    const norm = (v) => {
      v = String(v).trim().toLowerCase();
      if (/^#[0-9a-f]{3}$/.test(v)) v = '#' + v.slice(1).split('').map((c) => c + c).join('');
      return /^#[0-9a-f]{6}$/.test(v) ? v : null;
    };

    function commit() {
      window.applyThemeColors(custom);
      try {
        if (Object.keys(custom).length) localStorage.setItem('theme-custom', JSON.stringify(custom));
        else localStorage.removeItem('theme-custom');
      } catch (e) {}
      const root = document.documentElement;
      root.classList.add('theme-anim');
      clearTimeout(animT);
      animT = setTimeout(() => root.classList.remove('theme-anim'), 600);
      refresh();
    }

    function setColor(id, hex) {
      const def = KEYS.find((k) => k.id === id).def;
      if (hex === def) delete custom[id];
      else custom[id] = hex;
      commit();
    }

    function refresh() {
      KEYS.forEach((k) => {
        const r = rows[k.id];
        if (!r) return;
        const cur = custom[k.id] || k.def;
        r.chip.style.background = cur;
        r.code.textContent = cur.toUpperCase();
        r.wrap.classList.toggle('changed', !!custom[k.id]);
        r.picker.value = cur;
        if (document.activeElement !== r.hex) {
          r.hex.value = cur;
          r.hex.classList.remove('bad');
        }
        r.sws.forEach((s) => s.classList.toggle('sel', s.dataset.c === cur));
      });
    }

    KEYS.forEach((k) => {
      const wrap = document.createElement('div');
      wrap.className = 'tm-row-wrap';
      wrap.innerHTML = `
        <div class="tm-row">
          <div class="tm-info">
            <div class="tm-label">${k.label}<span class="tm-mod">editado</span></div>
            <div class="tm-desc">${k.desc}</div>
          </div>
          <button type="button" class="tm-color" aria-expanded="false" aria-label="Cambiar ${k.label}">
            <span class="tm-chip"></span><span class="tm-code"></span>
          </button>
        </div>
        <div class="tm-pal"><div class="tm-pal-inner"><div class="tm-pal-body">
          <div class="tm-grid"></div>
          <div class="tm-custom">
            <input type="color" class="tm-picker" aria-label="Color personalizado" />
            <input type="text" class="tm-hex" maxlength="7" spellcheck="false" aria-label="Código hexadecimal" />
            <button type="button" class="tm-row-reset">Original</button>
          </div>
        </div></div></div>`;
      list.appendChild(wrap);
      const btn = wrap.querySelector('.tm-color');
      const pal = wrap.querySelector('.tm-pal');
      const grid = wrap.querySelector('.tm-grid');
      const picker = wrap.querySelector('.tm-picker');
      const hex = wrap.querySelector('.tm-hex');
      const sws = PALETTE.map((c) => {
        const s = document.createElement('button');
        s.type = 'button';
        s.className = 'tm-sw';
        s.style.background = c;
        s.dataset.c = c;
        s.title = c;
        s.addEventListener('click', () => setColor(k.id, c));
        grid.appendChild(s);
        return s;
      });
      rows[k.id] = { wrap, chip: wrap.querySelector('.tm-chip'), code: wrap.querySelector('.tm-code'), picker, hex, sws };

      btn.addEventListener('click', () => {
        const open = !pal.classList.contains('open');
        // Cerrar cualquier otra paleta
        list.querySelectorAll('.tm-pal.open').forEach((p) => {
          p.classList.remove('open');
          p.parentElement.querySelector('.tm-color').setAttribute('aria-expanded', 'false');
        });
        pal.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) setTimeout(() => wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 150);
      });
      picker.addEventListener('input', () => setColor(k.id, picker.value.toLowerCase()));
      hex.addEventListener('input', () => {
        const v = norm(hex.value.startsWith('#') ? hex.value : '#' + hex.value);
        hex.classList.toggle('bad', !v);
        if (v) setColor(k.id, v);
      });
      wrap.querySelector('.tm-row-reset').addEventListener('click', () => {
        delete custom[k.id];
        commit();
      });
    });
    refresh();

    function close() {
      if (!modal.open) return;
      modal.classList.add('closing');
      setTimeout(() => {
        modal.classList.remove('closing');
        modal.close();
      }, 200);
    }

    openBtn.addEventListener('click', () => modal.showModal());
    document.getElementById('tm-close').addEventListener('click', close);
    document.getElementById('tm-done').addEventListener('click', close);
    document.getElementById('tm-reset-all').addEventListener('click', () => {
      custom = {};
      commit();
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
  })();
</script>
