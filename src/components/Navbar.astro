---
// Navbar.astro — shared navigation component
// Props: activePage = 'index' | 'gyms' | 'evs' | 'breeding'
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${baseUrl}/`,            label: 'Inicio',       key: 'index'    },
  { href: `${baseUrl}/gyms-farm`,   label: 'Gimnasios',   key: 'gyms'     },
  { href: `${baseUrl}/evs-farm`,    label: 'Farmeo de EVs', key: 'evs'    },
  { href: `${baseUrl}/breeding`,    label: 'Crianza',     key: 'breeding' },
  { href: `${baseUrl}/legendarios`, label: 'Legendarios', key: 'legendarios' },
];
---

<nav class="sticky top-0 z-50 backdrop-blur-xl border-b px-6 sm:px-12 py-3 flex items-center justify-between"
     style="background: rgba(11, 15, 25, 0.88); border-color: rgba(255,255,255,0.08);">

  <a href={`${baseUrl}/`} class="flex items-center gap-3 no-underline text-inherit group">
    <div class="brand-icon transition-transform duration-300 group-hover:scale-110"></div>
    <span class="font-outfit text-xl font-extrabold tracking-tight"
          style="background: linear-gradient(to right, #ffffff, #93c5fd); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      PokeMMO Tools
    </span>
  </a>

  <ul class="hidden sm:flex items-center gap-2 list-none">
    {links.map(link => (
      <li>
        <a href={link.href}
           class={`px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all duration-200 no-underline ${
             activePage === link.key
               ? 'text-white bg-white/10'
               : 'text-slate-400 hover:text-white hover:bg-white/6'
           }`}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Mobile hamburger (simple, sin JS) -->
  <details class="sm:hidden group relative">
    <summary class="list-none cursor-pointer p-2 rounded-lg hover:bg-white/8 text-slate-300 select-none">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </summary>
    <ul class="absolute right-0 top-10 w-48 bg-slate-900 border border-white/10 rounded-xl p-2 flex flex-col gap-1 list-none shadow-2xl">
      {links.map(link => (
        <li>
          <a href={link.href}
             class={`block px-3 py-2 rounded-lg text-sm font-semibold no-underline transition-colors ${
               activePage === link.key
                 ? 'text-white bg-blue-500/20'
                 : 'text-slate-300 hover:text-white hover:bg-white/8'
             }`}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>
