---
// Navbar.astro — Navigation with Collapsible Left Sidebar & Smooth Animated Accordions
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = [
  {
    id: 'cat-general',
    title: 'General',
    items: [
      { href: `${baseUrl}/`, label: 'Inicio', key: 'index' },
    ]
  },
  {
    id: 'cat-farm',
    title: 'Farmeo y Economía',
    items: [
      { href: `${baseUrl}/gyms-farm`, label: 'Gym Farm Tracker', key: 'gyms', badge: 'Diario' },
      { href: `${baseUrl}/evs-farm`, label: 'Farmeo de EVs', key: 'evs', badge: 'Hordas' },
    ]
  },
  {
    id: 'cat-breeding',
    title: 'Crianza y Competitivo',
    items: [
      { href: `${baseUrl}/breeding`, label: 'Simulador de Crianza', key: 'breeding', badge: 'Simulador' },
    ]
  },
  {
    id: 'cat-guides',
    title: 'Exploración y Guías',
    items: [
      { href: `${baseUrl}/legendarios`, label: 'Legendarios', key: 'legendarios', badge: 'Rotación' },
    ]
  }
];
---

<style is:global>
  /* Accordion collapse & expansion smooth animation */
  .accordion-content {
    max-height: 500px;
    opacity: 1;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease-in-out;
  }

  .accordion-content.is-closed {
    max-height: 0 !important;
    opacity: 0 !important;
    pointer-events: none;
  }

  /* Chevron rotation animation */
  .chevron-icon {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: rotate(90deg);
  }

  .chevron-icon.is-closed {
    transform: rotate(0deg);
  }
</style>

<!-- TOP HEADER BAR -->
<header class="sticky top-0 z-40 backdrop-blur-xl border-b px-4 sm:px-8 py-3 flex items-center justify-between"
        style="background: rgba(11, 15, 25, 0.92); border-color: rgba(255,255,255,0.08);">

  <div class="flex items-center gap-3">
    <!-- TOGGLE SIDEBAR BUTTON -->
    <button id="sidebar-toggle-btn"
            title="Alternar Menú Lateral"
            aria-label="Alternar Menú Lateral"
            class="p-2 rounded-xl border transition-all duration-200 hover:bg-white/10 text-slate-300 hover:text-white flex items-center justify-center cursor-pointer"
            style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1);">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/>
      </svg>
    </button>

    <!-- BRAND LOGO -->
    <a href={`${baseUrl}/`} class="flex items-center gap-2.5 no-underline text-inherit group">
      <div class="brand-icon transition-transform duration-300 group-hover:scale-105" style="width:32px; height:32px;"></div>
      <span class="font-outfit text-lg font-extrabold tracking-tight"
            style="background: linear-gradient(to right, #ffffff, #93c5fd); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        PokeMMO Tools
      </span>
    </a>
  </div>

  <!-- RIGHT HEADER ACTIONS -->
  <div class="flex items-center gap-3">
    <!-- STATUS BADGE -->
    <div class="hidden md:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold"
         style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.25); color: #4ade80;">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Servidores Online
    </div>

    <!-- BOTÓN MEJORAS DE LA COMUNIDAD -->
    <button id="community-btn"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl font-bold text-xs text-slate-200 transition-all duration-200 hover:bg-white/10 cursor-pointer"
            style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12);">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>Sugerencias</span>
    </button>
  </div>
</header>

<!-- BACKDROP OVERLAY -->
<div id="sidebar-backdrop"
     class="fixed inset-0 z-40 bg-black/60 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<!-- SIDEBAR (IZQUIERDA) -->
<aside id="sidebar-drawer"
       class="fixed top-0 left-0 bottom-0 z-50 w-72 flex flex-col transition-transform duration-300 -translate-x-full shadow-2xl"
       style="background: rgba(15, 23, 42, 0.96); border-right: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(16px);">

  <!-- SIDEBAR HEADER -->
  <div class="p-4 flex items-center justify-between border-b" style="border-color: rgba(255,255,255,0.08);">
    <div class="flex items-center gap-2.5">
      <div class="brand-icon" style="width:28px; height:28px;"></div>
      <span class="font-outfit font-extrabold text-base text-white">Navegación</span>
    </div>
    <button id="sidebar-close-btn"
            aria-label="Cerrar Menú"
            class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- TREE NAVIGATION LIST WITH ANIMATED ACCORDIONS -->
  <div class="flex-1 overflow-y-auto p-3 space-y-3">
    {categories.map((cat) => (
      <div class="accordion-item group">
        <button type="button"
                class="accordion-toggle flex items-center justify-between w-full px-2 py-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-400 hover:text-slate-200 cursor-pointer rounded transition-colors select-none">
          <span>{cat.title}</span>
          <svg class="chevron-icon w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="accordion-content">
          <div class="accordion-inner">
            <ul class="mt-1 pl-2 space-y-1 list-none border-l ml-2" style="border-color: rgba(255,255,255,0.08);">
              {cat.items.map(item => (
                <li>
                  <a href={item.href}
                     class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold no-underline transition-all duration-150 ${
                       activePage === item.key
                         ? 'text-white bg-blue-600/30 border border-blue-500/40 shadow-[0_0_12px_rgba(59,130,246,0.2)]'
                         : 'text-slate-300 hover:text-white hover:bg-white/6'
                     }`}>
                    <span>{item.label}</span>
                    {item.badge && (
                      <span class="text-[10px] font-bold px-1.5 py-0.5 rounded"
                            style="background: rgba(255,255,255,0.06); color: #94a3b8; border: 1px solid rgba(255,255,255,0.08);">
                        {item.badge}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- SIDEBAR FOOTER -->
  <div class="p-4 border-t space-y-3" style="border-color: rgba(255,255,255,0.08); background: rgba(0,0,0,0.2);">
    <div class="text-xs text-slate-400 flex justify-between items-center">
      <span class="font-medium">PokeMMO Tools</span>
      <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 font-mono">v1.2</span>
    </div>
  </div>
</aside>

<!-- SUGGESTIONS MODAL / POPUP -->
<dialog id="community-modal" class="rounded-2xl bg-slate-900 border text-slate-200 p-6 max-w-md w-full backdrop:bg-black/70 shadow-2xl" style="border-color: rgba(255,255,255,0.15);">
  <form method="dialog" class="space-y-4">
    <div class="flex justify-between items-center">
      <h3 class="font-outfit text-lg font-bold text-white flex items-center gap-2">
        Mejoras de la Comunidad
      </h3>
      <button class="text-slate-400 hover:text-white text-lg">✕</button>
    </div>
    <p class="text-xs text-slate-400 leading-relaxed">
      ¿Tienes alguna idea para mejorar la web o quieres reportar un error? Déjanos tu sugerencia.
    </p>
    <textarea rows="4" placeholder="Escribe tu sugerencia aquí..." class="w-full bg-slate-950 border border-slate-700 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-blue-500"></textarea>
    <div class="flex justify-end gap-2">
      <button type="button" onclick="document.getElementById('community-modal').close()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:bg-white/5">Cancelar</button>
      <button type="button" onclick="document.getElementById('community-modal').close()" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500">Cerrar</button>
    </div>
  </form>
</dialog>

<script is:inline>
  (function initNavbarScript() {
    // Universal event delegation for accordion toggles & sidebar controls
    document.addEventListener('click', (e) => {
      // 1. Accordion Header Toggle
      const toggleBtn = e.target.closest('.accordion-toggle');
      if (toggleBtn) {
        const item = toggleBtn.closest('.accordion-item');
        if (item) {
          const content = item.querySelector('.accordion-content');
          const chevron = item.querySelector('.chevron-icon');
          if (content) content.classList.toggle('is-closed');
          if (chevron) chevron.classList.toggle('is-closed');
        }
        return;
      }

      // 2. Sidebar Open Toggle
      if (e.target.closest('#sidebar-toggle-btn')) {
        const drawer = document.getElementById('sidebar-drawer');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (drawer) drawer.classList.remove('-translate-x-full');
        if (backdrop) backdrop.classList.remove('opacity-0', 'pointer-events-none');
        return;
      }

      // 3. Sidebar Close Toggle / Backdrop Click
      if (e.target.closest('#sidebar-close-btn') || e.target.closest('#sidebar-backdrop')) {
        const drawer = document.getElementById('sidebar-drawer');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (drawer) drawer.classList.add('-translate-x-full');
        if (backdrop) backdrop.classList.add('opacity-0', 'pointer-events-none');
        return;
      }

      // 4. Community Suggestions Modal
      if (e.target.closest('#community-btn')) {
        const communityModal = document.getElementById('community-modal');
        if (communityModal && typeof communityModal.showModal === 'function') {
          communityModal.showModal();
        }
        return;
      }
    });
  })();
</script>


