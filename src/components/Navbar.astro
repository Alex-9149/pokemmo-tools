---
// Navbar.astro — Master component switching between Horizontal and Vertical Navbars
import NavbarHorizontal from './NavbarHorizontal.astro';
import NavbarVertical from './NavbarVertical.astro';

interface Props {
  activePage?: string;
  variant?: 'horizontal' | 'vertical';
}

// 💡 CAMBIA ESTA VARIABLE para alternar el Navbar en toda la web:
// 'horizontal' -> Navbar superior original
// 'vertical'   -> Menú lateral desplegable nuevo
const DEFAULT_NAVBAR: 'horizontal' | 'vertical' = 'horizontal';

const { activePage = '', variant = DEFAULT_NAVBAR } = Astro.props;
---

{variant === 'horizontal' ? (
  <NavbarHorizontal activePage={activePage} />
) : (
  <NavbarVertical activePage={activePage} />
)}
